---
import { siteConfig } from "../../config/site";
import Icon from "./Icon.astro";

interface Props {
  /** Stable id used in analytics (cta_id). Never display text. */
  id: string;
  /** Placement name used in analytics (cta_location). Stable, never display text. */
  location: "hero" | "final" | "mobile_sticky" | "course_offer";
  label: string;
  /** Marks a button inside a pricing section, so early_bird_cta_clicked fires alongside whatsapp_cta_clicked. */
  earlyBird?: boolean;
  /** Marks the reward button, so reward_whatsapp_clicked fires alongside whatsapp_cta_clicked. */
  reward?: boolean;
  /** A wa.me link with its own prefilled message. Defaults to the shared message in site.ts. */
  href?: string;
}
const { id, location, label, earlyBird = false, reward = false, href = siteConfig.whatsappUrl } = Astro.props;
---

<a
  class="btn btn--go"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-cta-id={id}
  data-cta-location={location}
  data-early-bird={earlyBird ? "" : undefined}
  data-reward={reward ? "" : undefined}
>
  <Icon name="message-circle" />
  <span>{label}</span>
  <Icon name="arrow-right" class="btn__arrow" />
</a>
