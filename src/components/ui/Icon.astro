---
import graduationCap from "lucide-static/icons/graduation-cap.svg?raw";
import messagesSquare from "lucide-static/icons/messages-square.svg?raw";
import sprout from "lucide-static/icons/sprout.svg?raw";
import users from "lucide-static/icons/users.svg?raw";
import arrowDown from "lucide-static/icons/arrow-down.svg?raw";
import target from "lucide-static/icons/target.svg?raw";
import arrowRight from "lucide-static/icons/arrow-right.svg?raw";
import check from "lucide-static/icons/check.svg?raw";
import messageCircle from "lucide-static/icons/message-circle.svg?raw";
import trendingUp from "lucide-static/icons/trending-up.svg?raw";
import store from "lucide-static/icons/store.svg?raw";
import quote from "lucide-static/icons/quote.svg?raw";
import clock from "lucide-static/icons/clock.svg?raw";
import monitor from "lucide-static/icons/monitor.svg?raw";
import shoppingBag from "lucide-static/icons/shopping-bag.svg?raw";
import creditCard from "lucide-static/icons/credit-card.svg?raw";
import sparkles from "lucide-static/icons/sparkles.svg?raw";
import briefcase from "lucide-static/icons/briefcase.svg?raw";
import globe from "lucide-static/icons/globe.svg?raw";
import gift from "lucide-static/icons/gift.svg?raw";
import copy from "lucide-static/icons/copy.svg?raw";
import arrowLeft from "lucide-static/icons/arrow-left.svg?raw";
import chevronDown from "lucide-static/icons/chevron-down.svg?raw";
import badgeCheck from "lucide-static/icons/badge-check.svg?raw";
import wallet from "lucide-static/icons/wallet.svg?raw";

const icons = {
  "check": check,
  "arrow-right": arrowRight,
  "graduation-cap": graduationCap,
  "messages-square": messagesSquare,
  "sprout": sprout,
  "users": users,
  "arrow-down": arrowDown,
  "target": target,
  "message-circle": messageCircle,
  "trending-up": trendingUp,
  "wallet": wallet,
  "monitor": monitor,
  "shopping-bag": shoppingBag,
  "credit-card": creditCard,
  "sparkles": sparkles,
  "briefcase": briefcase,
  "globe": globe,
  "arrow-left": arrowLeft,
  "chevron-down": chevronDown,
  "badge-check": badgeCheck,
  "store": store,
  "quote": quote,
  "clock": clock,
  "gift": gift,
  "copy": copy,
} as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}
const { name, class: extra = "" } = Astro.props;
// Lucide SVGs are static files from our own dependency, never user content.
const svg = icons[name].replace(/<!--[\s\S]*?-->/, "").trim();
---

<span class={`icon ${extra}`.trim()} aria-hidden="true" set:html={svg} />
