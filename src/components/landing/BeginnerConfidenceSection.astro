---
import type { LoadedContent } from "../../content/content-loader";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";

interface Props {
  index: number;
  content: LoadedContent;
}
const { index, content } = Astro.props;
const c = content.page.shared.confidence;
---

<Section id="confidence" index={index} tone="tint">
  <div class="bc">
    <div class="bc__intro">
      <h2 id="confidence-title" class="bc__worry">{c.headline}</h2>
      <span class="bc__arrow" aria-hidden="true"><Icon name="arrow-down" /></span>
      <div class="bc__answer">
        <p class="bc__core">{c.answer}</p>
        <p class="bc__support">{c.description}</p>
      </div>
    </div>

    <div class="bc__need">
      <ul class="bc__points">
        {
          c.points.map((p) => (
            <li>
              <span class="chip"><Icon name={p.icon} /></span>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="statement bc__closing">{c.closing}</p>
    </div>
  </div>
</Section>
