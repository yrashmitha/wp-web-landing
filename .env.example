# Operational configuration. Copy to .env and fill in. Only PUBLIC_ values are exposed to the browser.
# Never put secrets here: every value below ends up in the page source.

# Canonical origin of the deployed site, no trailing slash.
PUBLIC_SITE_URL=

# Analytics. Leave blank to disable. If a GTM container is set, GA4 and Meta Pixel
# are expected to be managed inside GTM and are NOT loaded directly.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# "true" (default) holds all analytics until the visitor accepts the consent banner.
PUBLIC_REQUIRE_CONSENT=true
